# ViralOS — copy to .env.local
# Official Anthropic: sk-ant-...
# CCR + OpenRouter (recommended when using ~/.claude-code-router/config.json):
#   npm run ops:ccr:env-local
#   npm run ops:ccr:start    # Mac + Ubuntu via SSH -R 3456
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=http://127.0.0.1:3456 (:8001 on Ubuntu) — NOT https://gateway.datapro.asia (that is llm-gateway :3000).
#
# Mac dev → Ubuntu on LAN (recommended):
#   API_PROXY_BASE_URL=http://192.168.1.4:8001
# ViralOS running on Ubuntu:
#   API_PROXY_BASE_URL=http://127.0.0.1:8001
# Leave unset on Vercel if you only need /api/campaign (no stock/dataproai proxy).
API_PROXY_BASE_URL=http://192.168.1.4:8001

# After SSE complete, POST campaign to gateway ingest (requires API_PROXY_BASE_URL)
# VIRALOS_AUTO_INGEST=0
# VIRALOS_INGEST_TOKEN=   # must match gateway VIRALOS_INGEST_TOKEN when set

# Proxy resilience (Phase 1.3)
API_PROXY_TIMEOUT_MS=30000
API_PROXY_RETRIES=2
API_PROXY_RETRY_DELAY_MS=500
