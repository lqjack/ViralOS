{
  "name": "viralOS",
  "version": "1.0.0",
  "type": "module",
  "description": "AI-Native Growth Operating System — Turn any product into a viral campaign",
  "private": false,
  "license": "MIT",
  "keywords": [
    "ai", "agents", "marketing", "viral", "content-generation",
    "anthropic", "claude", "open-source", "growth-hacking"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "demo": "node examples/basic-campaign.js",
    "smoke-test": "node scripts/smoke-test.mjs",
    "smoke-test:ci": "node scripts/smoke-with-server.mjs",
    "verify:no-mock": "bash scripts/verify-no-mock.sh",
    "test": "node --test scripts/campaign-lib.test.mjs scripts/campaign-validate.test.mjs scripts/sse-parse.test.mjs scripts/sse-campaign-e2e.test.mjs scripts/gateway-client.test.mjs scripts/real-ai-guard.test.mjs scripts/campaign-ingest.test.mjs",
    "verify:func": "npm run verify:no-mock && npm run test",
    "verify": "npm run build && npm run verify:func",
    "verify:full": "npm run verify && npm run smoke-test:ci",
    "verify:e2e-real": "node scripts/verify-e2e-real.mjs",
    "verify:ubuntu": "node scripts/verify-ubuntu-e2e.mjs",
    "verify:ubuntu:real": "VERIFY_UBUNTU_REAL=1 node scripts/verify-ubuntu-e2e.mjs --real",
    "verify:cross-repo-live": "node scripts/cross-repo-live-e2e.mjs",
    "deploy:ubuntu": "./scripts/ubuntu/deploy-viralos.sh",
    "deploy:ubuntu:sync": "./scripts/deploy-ubuntu-sync.sh",
    "verify:ubuntu:all": "./scripts/ubuntu/verify-all-on-ubuntu.sh",
    "verify:local-design": "node scripts/verify-local-design.mjs",
    "verify:lan-resume": "./scripts/ubuntu/verify-lan-resume.sh",
    "verify:all": "npm run verify:local-design"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "@anthropic-ai/sdk": "^0.24.0",
    "lucide-react": "^0.383.0"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^20",
    "@types/react": "^18",
    "tailwindcss": "^3.4.0",
    "autoprefixer": "^10.0.1",
    "postcss": "^8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/viralOS/viralOS"
  },
  "homepage": "https://viralOS.ai",
  "bugs": {
    "url": "https://github.com/viralOS/viralOS/issues"
  }
}
